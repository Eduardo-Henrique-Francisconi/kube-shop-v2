# Exemplo para execução local (a pipeline usa TF_VAR_*). Não versione o terraform.tfvars real.
environment            = "dev"
instance_name          = "vm-kubeshop"
instance_type          = "Standard_B1ms"
db_instance_type       = "Standard_B2s"
db_data_disk_gb        = 16
backup_storage_account = "stkubeshopxxxxx"
ssh_public_key         = "ssh-ed25519 AAAA... kubeshop-pipeline"
admin_cidrs            = []
