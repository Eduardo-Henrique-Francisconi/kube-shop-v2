#!/usr/bin/env bash
# Restaura o banco kubeshop a partir de um backup.
#   kubeshop-restore latest                      -> backup remoto mais recente
#   kubeshop-restore kubeshop-dev-...archive.gz  -> backup específico
# Substitui (--drop) as coleções do banco kubeshop. Não altera usuários do MongoDB.
set -euo pipefail
source /etc/kubeshop/backup.env
name="${1:?informe o nome do backup ou 'latest'}"

if [ "${name}" = "latest" ]; then
  name="$(curl -fsS "${BACKUP_URL}${BACKUP_SAS}&restype=container&comp=list&prefix=kubeshop-${ENV_NAME}-" \
    | grep -o '<Name>[^<]*</Name>' | sed -e 's/<[^>]*>//g' | sort | tail -n1)"
  [ -n "${name}" ] || { echo "[restore] nenhum backup remoto encontrado" >&2; exit 1; }
fi
case "${name}" in
  kubeshop-*.archive.gz) ;;
  *) echo "[restore] nome inválido: ${name}" >&2; exit 1 ;;
esac

file="${BACKUP_LOCAL_DIR}/${name}"
if [ ! -s "${file}" ]; then
  echo "[restore] baixando ${name} do Azure Blob Storage"
  curl -fsS --retry 3 -o "${file}.tmp" "${BACKUP_URL}/${name}${BACKUP_SAS}"
  mv "${file}.tmp" "${file}"
fi
gzip -t "${file}"

before="$(docker exec "${MONGO_CONTAINER}" mongosh --quiet --file /opt/count-orders.js)"
echo "[restore] antes:  ${before}"
docker exec -i "${MONGO_CONTAINER}" mongorestore --quiet \
  --config /run/secrets/mongotools.yml --username admin --authenticationDatabase admin \
  --nsInclude 'kubeshop.*' --drop --archive --gzip < "${file}"
after="$(docker exec "${MONGO_CONTAINER}" mongosh --quiet --file /opt/count-orders.js)"
echo "[restore] depois: ${after}"
echo "RESTORE_OK name=${name} before=${before} after=${after}"
